# Fim de linha LF em todo texto, em qualquer sistema (Dockerfile, *.yml, *.sh
# e *.ts quebram com CRLF no Linux do CI e do contêiner).
* text=auto eol=lf

*.sh text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.md text eol=lf

*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.woff binary
*.woff2 binary
