{
  "name": "tempestivo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": ">=12.16.1 <13"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:cobertura": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "imagens": "node scripts/gerar-imagens.mjs",
    "db:migrar": "prisma migrate dev",
    "db:aplicar": "prisma migrate deploy",
    "verificar": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.25",
    "class-variance-authority": "^0.7.1",
    "cn": "0.5.2",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "nodemailer": "10.5.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "7.10.1",
    "shadcn": "4.23.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.16.1"
}
