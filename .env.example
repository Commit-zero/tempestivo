# Ambiente de execução: development, test ou production.
NODE_ENV=development
# URL pública do app, usada em links de e-mail e nos cookies de sessão.
APP_URL=http://localhost:3000
# Segredo dos jobs, mínimo de 32 caracteres. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JOBS_SECRET=
# Segredo das sessões de login, mínimo de 32 caracteres. Gere do mesmo jeito, com outro valor.
AUTH_SECRET=
# Banco PostgreSQL. O valor abaixo é o do docker-compose local (porta 54329).
DATABASE_URL=postgresql://postgres:postgres@localhost:54329/tempestivo
# Nível mínimo do log: debug, info, warn ou error.
LOG_LEVEL=info
# Envio de e-mail: "fake" (não envia) ou "smtp". Com o docker-compose local, use smtp.
MAILER_DRIVER=smtp
# Servidor SMTP. O Mailpit local escuta em localhost:54325 (caixa em http://localhost:54380).
SMTP_HOST=localhost
# Porta do SMTP: 54325 no Mailpit local, 587 no Gmail e no Brevo.
SMTP_PORT=54325
# Usuário do SMTP. Vazio no Mailpit.
SMTP_USER=
# Senha do SMTP (no Gmail, uma senha de app). Vazia no Mailpit.
SMTP_PASS=
# Remetente dos e-mails.
EMAIL_REMETENTE=Tempestivo <nao-responda@tempestivo.local>
# Leitor de intimação: "local" lê por regras no próprio servidor, sem enviar o texto a terceiros.
AI_DRIVER=local
