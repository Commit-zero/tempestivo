# Ambiente de execução: development, test ou production.
NODE_ENV=development
# URL pública do app, usada em links de e-mail.
APP_URL=http://localhost:3000
# Segredo dos jobs, mínimo de 32 caracteres. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JOBS_SECRET=
# Nível mínimo do log: debug, info, warn ou error.
LOG_LEVEL=info
# Armazenamento de arquivos. Por enquanto só "fake".
STORAGE_DRIVER=fake
# Envio de e-mail. Por enquanto só "fake".
MAILER_DRIVER=fake
# Notificações. Por enquanto só "fake".
NOTIFIER_DRIVER=fake
# Leitor de intimação (IA). Por enquanto só "fake".
AI_DRIVER=fake
